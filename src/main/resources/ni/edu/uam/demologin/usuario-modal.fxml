<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.demologin.controller.UsuarioModalController"
      prefHeight="450" prefWidth="500"
      alignment="CENTER"
      spacing ="15"
>
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Usuario Registrado"
           style="-fx-font-size:22px;
                  -fx-font-weight:bold"/>
    <ImageView fx:id="imageFoto"
               fitWidth="150"
               fitHeight="150"
               preserveRatio="true"/>

    <GridPane hgap="10" vgap="8" alignment="CENTER">
        <Label text="Nombre:" style="-fx-font-weight:bold" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="lblNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Apellido:" style="-fx-font-weight:bold" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="lblApellido" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Correo:" style="-fx-font-weight:bold" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="lblCorreo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Usuario:" style="-fx-font-weight:bold" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="lblUsuario" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Foto:" style="-fx-font-weight:bold" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Label fx:id="lblRutaFoto" wrapText="true" maxWidth="320" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Aceptar" prefWidth="150" onAction="#mostrarFoto"/>
</VBox>
