<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.demologin.controller.VistaUsuariosController"
            prefWidth="600" prefHeight="400">

    <VBox spacing="10" alignment="CENTER"
          AnchorPane.topAnchor="10"
          AnchorPane.leftAnchor="10"
          AnchorPane.rightAnchor="10"
          AnchorPane.bottomAnchor="10">

        <Label text="Usuarios Registrados"
               style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Agregar" onAction="#agregarUsuario"
                    style="-fx-background-color: #1F6822FF; -fx-text-fill: white;"/>

            <Button text="Cerrar sesión" onAction="#cerrarSesion"/>
        </HBox>

        <TableView fx:id="tablaUsuarios" prefHeight="300" prefWidth="580" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="No hay usuarios registrados"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="100"/>
                <TableColumn fx:id="colApellido" text="Apellido" prefWidth="100"/>
                <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="90"/>
                <TableColumn fx:id="colCorreo" text="Correo" prefWidth="140"/>
                <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="140" sortable="false"/>
            </columns>
        </TableView>

    </VBox>
</AnchorPane>
